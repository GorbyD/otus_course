{
  "autoload": {
    "psr-4": {
      "": "src/"
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/GorbyD/otus-composer-package.git"
    }
  ],
  "require": {
    "php": ">=8.0",
    "denis/otus-util": "^1.0.0",
    "ext-redis": "*",
    "elasticsearch/elasticsearch": "^8.0",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  }
}
